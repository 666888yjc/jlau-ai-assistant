# 吉小农薄壳后端环境变量模板
# 复制为 .env 并填入真实值；切勿提交真实 token。
# 注：server 当前未内置 dotenv，请 export 后 npm start，或由部署平台注入。

# ===== Coze 接入（生产必填；留空自动启用 mock 流）=====
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_API_BASE=https://api.coze.cn
COZE_USER_ID=jlau-shell

# ===== 运行模式 =====
COZE_MOCK=true            # true=mock 流（无 token 时强制）；false=真实调用 Coze
STORE_KIND=json           # json | cloudbase | memory

# ===== 服务 =====
PORT=3100                 # 建议 3100 避开前端 dev 的 3000 冲突
DATA_DIR=                 # 留空=server/data；容器/云函数可指向持久卷

# ===== 限流（可选）=====
# RATE_WINDOW_MS=60000
# RATE_CHAT_MAX=20
# RATE_DATA_MAX=60

# ===== 前端联调真实后端（仅 web/vite 使用）=====
# VITE_USE_REAL_API=1
# VITE_API_TARGET=http://localhost:3100

# ===== 反馈管理后台（方案 A，A-4；未配置 = 后台整体关闭 503）=====
# 必配：管理后台登录密码（无账号体系，单密码 + HMAC 会话令牌）。
# ⚠️ 未配置 ADMIN_PASSWORD 时，/api/v1/admin/* 与前端 /admin 一律 503 code 4011「管理后台未启用」，
#    不存在空密码放行路径。部署务必显式注入强密码。
ADMIN_PASSWORD=
# 可选：会话令牌有效期（毫秒，默认 12h = 43200000）
# ADMIN_SESSION_TTL_MS=43200000
# 可选：登录失败锁定窗口（毫秒，默认 15min = 900000）
# ADMIN_LOGIN_FAIL_WINDOW_MS=900000
# 可选：窗口内失败次数阈值（默认 5）
# ADMIN_LOGIN_FAIL_MAX=5
