# 吉小农薄壳后端环境变量模板
# 复制为 .env 并填入真实值；切勿提交真实 token。
# 注：server 当前未内置 dotenv，请 export 后 npm start，或由部署平台注入。

# ===== Coze 接入（生产必填；留空自动启用 mock 流）=====
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_API_BASE=https://api.coze.cn
COZE_USER_ID=jlau-shell

# ===== 运行模式 =====
COZE_MOCK=true            # true=mock 流（无 token 时强制）；false=真实调用 Coze
STORE_KIND=json           # json | cloudbase | memory

# ===== 服务 =====
PORT=3100                 # 建议 3100 避开前端 dev 的 3000 冲突
DATA_DIR=                 # 留空=server/data；容器/云函数可指向持久卷

# ===== 限流（可选）=====
# RATE_WINDOW_MS=60000
# RATE_CHAT_MAX=20
# RATE_DATA_MAX=60

# ===== 前端联调真实后端（仅 web/vite 使用）=====
# VITE_USE_REAL_API=1
# VITE_API_TARGET=http://localhost:3100
