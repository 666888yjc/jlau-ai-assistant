# 吉小农后端环境变量模板（复制为 .env 后填真实值，.env 已被 gitignore 忽略）
# 注意：所有密钥只进 .env，禁止写入代码或前端；前端永远不持有任何 API key。

# ===== 高德地图 Web 服务 API（用于 route-B 实时位置/导航/周边检索）=====
# 在 https://lbs.amap.com/ 控制台「应用管理」创建应用，服务平台选「Web服务」获取 key
AMAP_API_KEY=your_amap_web_service_key_here

# 如需前端地图展示（route-B 成熟后），单独申请「Web端(JS API)」类型的 key 填入下方，
# 该 key 会暴露在前端，建议配域名白名单+配额限制
# AMAP_JS_KEY=your_amap_js_key_here

# ===== Coze（route-A 元器模式不需要；route-B 可选，默认走 SiliconFlow）=====
# COZE_API_TOKEN=your_coze_token_here
# COZE_BOT_ID=your_coze_bot_id_here

# ===== 大模型（route-B 自托管大脑，OpenAI 兼容接口）=====
# 硅基流动 SiliconFlow：https://cloud.siliconflow.cn 注册后「API 密钥」新建
LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your_siliconflow_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# 设为 true 可强制回到 mock 流（无外部调用，便于离线测试）
LLM_MOCK=false

# ===== 本地知识库目录（route-B 后端检索用，零代码维护：替换/增删 .md 即可）=====
KB_DIR=./kb

# ===== 服务端口 =====
PORT=3100
